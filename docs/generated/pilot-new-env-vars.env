# =============================================================================
# Merlinus — NEW environment variables from pilot readiness work (2026-07-31)
# Paste into Cloudflare → Workers → merlinus-platform → Settings → Variables
#   Plaintext vars: use "Variables" (non-secret)
#   Secrets: use "Secrets" (encrypted) — do not put secrets in git after fill-in
#
# SKIP anything you already set. These are only vars introduced / emphasized
# for pilot + self-heal + billing + provision gates.
# =============================================================================

# --- Self-heal / nightly maintenance (main Worker: merlinus-platform) ---
GROK_SELF_HEAL_ENABLED=true
GROK_SELF_HEAL_MODEL=grok-3-mini
MERLIN_MAINTENANCE_TZ=America/New_York
MERLIN_NIGHTLY_WINDOW_START=20
MERLIN_NIGHTLY_WINDOW_END=6
MERLIN_NIGHTLY_SOFT_MAINTENANCE=true
# SECRET — also set on workers/ops-cron companion:
OPS_MAINTENANCE_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32

# --- Provision / pilot readiness (main Worker) ---
# Required for national Onboard New Dealership button:
APEX_ALLOW_HTTP_PROVISION=true
# Leave UNSET for pilot (readiness gate stays on). Break-glass only:
# APEX_PROVISION_SKIP_READINESS=true

# --- MFA (set true only after ALL elevated staff enrolled) ---
# MERLIN_MFA_ENFORCE=true

# --- National owner billing estimates (main Worker — optional, UI rates) ---
BILLING_PLATFORM_MONTHLY_CENTS=29900
BILLING_STORY_FIRST_CENTS=95
BILLING_STORY_HIGH_VOLUME_CENTS=65
BILLING_HIGH_VOLUME_THRESHOLD=400
BILLING_STORY_REGEN_CENTS=25
BILLING_SMS_CENTS=4
BILLING_CURRENCY=USD

# --- ops-cron companion Worker only (merlinus-ops-cron) ---
# APP_BASE_URL=https://YOUR-PRODUCTION-HOST
# OPS_MAINTENANCE_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32
# (same secret as main Worker)
