# =============================================================================
# Merlinus — NEW environment variables from pilot readiness work (2026-07-31)
#
# NON-SECRETS: shipped via wrangler.toml [vars] on the main Worker.
#   See: wrangler.toml → [vars] (GROK_SELF_HEAL_*, MERLIN_NIGHTLY_*, BILLING_*,
#   APEX_ALLOW_HTTP_PROVISION). Next deploy applies them — no dashboard typing.
#
# SECRETS: dashboard / `wrangler secret put` only (never commit):
#   OPS_MAINTENANCE_SECRET
#   (ops-cron also needs APP_BASE_URL + same OPS_MAINTENANCE_SECRET)
# =============================================================================

# --- Secrets only (main Worker merlinus-platform) ---
# OPS_MAINTENANCE_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32

# --- ops-cron companion Worker only (merlinus-ops-cron) ---
# APP_BASE_URL=https://YOUR-PRODUCTION-HOST
# OPS_MAINTENANCE_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32
